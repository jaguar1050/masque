# Project MASQUE demo. Scoped to /demo -- does not affect the site root.

<IfModule mod_mime.c>
  # .jsx is fetched as text and compiled in the browser, so it only needs to
  # arrive as UTF-8 text rather than as an octet-stream download.
  AddType text/javascript .js .mjs .jsx
  AddCharset UTF-8 .js .mjs .jsx .html .css
</IfModule>

# No directory listing of src/.
Options -Indexes

<IfModule mod_headers.c>
  # Prototype tooling: keep it out of search indexes at the header level too,
  # for crawlers that fetch .jsx directly and never see the <meta> tag.
  <FilesMatch "\.(jsx|mjs)$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>
